# Copy to .env and fill in. .env is git-ignored. Every value here is optional:
# with nothing set, `npm run dev` boots the offline dev world.

# ---- client (VITE_* is inlined into the public bundle, so never put a secret here) ----
# Google Map Tiles API key. Restrict it to your domains (see README).
VITE_GOOGLE_TILES_KEY=
# Multiplayer + leaderboard relay. Local default shown; set it to your deployed worker
# (wss://<name>.<subdomain>.workers.dev) for production builds.
VITE_MP_SERVER=ws://localhost:8787
# Optional: a separate scores URL. Defaults to VITE_MP_SERVER with ws -> http.
VITE_SCORES_URL=
# LOW | MED | HIGH | ULTRA. G cycles it in game. Higher = sharper, more tile downloads.
VITE_TILE_QUALITY=HIGH

# ---- server only (Vercel env vars, never VITE_-prefixed) -----------------------------
# Ticketmaster Discovery API key for /api/whats-on. Without it the endpoint returns an
# empty list and the game shows no events. scripts/no-secret-leak.test.mjs fails the
# build if it ever reaches dist/.
TICKETMASTER_API_KEY=
# Optional query parameters appended to outbound ticket links, e.g. "utm_source=mygame".
TICKETMASTER_AFFILIATE=
